<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-facing text. The codebase is English; the product speaks Chinese, because it
  answers a Chinese-speaking user (spec §12). Keeping the copy here rather than inline means
  the Kotlin stays readable and the wording stays reviewable in one place.
-->
<resources>
    <string name="app_name">FishBall</string>

    <!-- Masthead -->
    <string name="wordmark">FISHBALL</string>
    <string name="memory">记忆</string>
    <string name="more">更多</string>
    <string name="settings">设置</string>

    <!--
      Settings. Two things only, because they are the only two the user can meaningfully
      change; the model is named for what it does to them, not for what it is.
    -->
    <!-- Shown in the thread when the session was folded, so the change is visible rather than felt. -->
    <string name="session_compacted">好，我把刚才聊的整理了一下，接着聊。</string>
    <!-- Left in the thread when the user stops a turn themselves, so a stopped question
         does not look like one that failed. -->
    <string name="turn_stopped">好，那就先不查了。想问别的随时说。</string>

    <string name="settings_mode">模式</string>
    <string name="mode_fast">快速模式</string>
    <string name="mode_pro">专业模式</string>
    <!-- Shown while a model switch reads the conversation back. Folding, not thinking. -->
    <string name="compacting">整理中…</string>
    <string name="mode_note">换模式以后，之前聊的会整理成一段摘要再接着聊。</string>
    <string name="mode_unavailable">当前激活码不支持专业模式</string>
    <string name="settings_key">激活码</string>

    <!--
      Spec §9. The count comes first because it is the part someone can picture; the size is
      there for the one question the count cannot answer, which is whether it matters.
    -->
    <string name="settings_history">对话记录</string>
    <string name="history_summary">%1$d 条 · %2$s</string>
    <!--
      The bin's two states. 清空 is now only the control's name — what a screen reader reads out
      — because the button itself is a drawing rather than a word. The prompt is what the second
      tap answers, and it names what is about to go: there are two of these bins in the app now,
      one per screen, and "清空" alone would be the same sentence in both.
    -->
    <string name="history_clear">清空</string>
    <string name="history_clear_confirm">再次点击清空会话</string>
    <string name="settings_change">更改</string>
    <string name="settings_save">保存</string>
    <string name="settings_cancel">取消</string>

    <!-- Only a content description: the arrow says it, and a label beside it would not fit. -->
    <string name="jump_to_end">回到最新</string>

    <!-- Composer: no placeholder by design. The field and the send control carry it. -->
    <string name="send">发送</string>
    <!-- The plate while a turn or a transcription is running. Tapping it calls the work off. -->
    <string name="stop_turn">别查了</string>
    <!-- The notification posted when an answer lands and nobody is watching for it. -->
    <string name="notify_title">鱼丸查好了</string>
    <string name="notify_channel">查好了通知</string>
    <string name="notify_channel_why">agent 把答案写完的时候提醒你一声。</string>

    <!-- The ongoing notice that keeps the app alive while it is looking something up. -->
    <string name="notify_working">鱼丸正在查……</string>
    <string name="notify_working_channel">正在查的时候</string>
    <string name="notify_working_channel_why">答案还没查完的时候，这条通知让系统别把鱼丸停掉。不会响。</string>
    <!-- Settings: the row that turns the above, and the sound, on and off. -->
    <string name="notify_setting">查好了提醒我</string>
    <string name="notify_setting_why">答案写完的时候响一声。App 不在前台的话，再发一条通知。</string>

    <!--
      Attaching a picture. Two ways in, named for what the person does rather than for where
      the file comes from: 图片 is the one already on the phone, 拍照 is the one taken now.
    -->
    <string name="attach">添加</string>
    <string name="attach_image">图片</string>
    <string name="attach_camera">拍照</string>
    <string name="attach_remove">去掉这张</string>
    <!-- Shown in the row itself once the cap is reached, so the two choices greying out is explained. -->
    <string name="attach_full">最多 %1$d 张</string>

    <!--
      Speaking instead of typing. The button is the send plate until there is something to
      send, so with an empty field it is a microphone — held down, not tapped, which the
      second line says outright because nothing about the control itself can.
    -->
    <string name="voice_hold">按住说话</string>
    <string name="voice_recording">录音中</string>
    <string name="voice_release">松开发送语音</string>
    <!-- While the button is held. The gesture is the one every voice message here is
         cancelled with, and the second line is what it becomes once the finger is high enough. -->
    <string name="voice_cancel">上滑取消语音</string>
    <string name="voice_cancel_armed">松开手指，取消发送</string>
    <string name="voice_transcribing">正在转文字…</string>
    <!-- Heard nothing usable. Says what to do, and does not blame the microphone or the person. -->
    <!-- Let go before a second was up. Says which nothing it was, so a mis-tap and a broken
         microphone do not look alike. -->
    <string name="voice_too_short">语音消息太短。</string>
    <string name="voice_empty">没听清，再说一遍吧。</string>
    <!-- The permission was refused. One line, and the place it can be changed. -->
    <string name="voice_no_permission">要先允许鱼丸用麦克风才能说话。</string>

    <!-- The thread before anything is in it. Author's copy, approved 2026-08-31. -->
    <string name="thread_empty">我是鱼丸，你的私人AI助理，来问我第一个问题，让我们一起探索这个世界吧！</string>

    <!-- Activation: spec §1, one key handed over in person. No instructional paragraph -
         the placeholder names what is being asked for and that is the whole instruction. -->
    <string name="gate_key_hint">请输入激活码</string>
    <string name="gate_confirm">确认</string>
    <!--
      Two failures, told apart because only one of them is the person's to fix. A status code
      would be honest and useless; neither line mentions keys, servers or networks by name.
    -->
    <string name="gate_key_rejected">激活码无效</string>
    <string name="gate_unreachable">现在连不上，等一下再试。</string>
    <!-- Key good, service up, neither model on offer. Nothing the user can do, so it says who to tell. -->
    <string name="gate_no_model">服务上没有可用的模型，跟给你激活码的人说一声。</string>
    <!--
      The same failure on a profile the user configured themselves. The line above sends them
      to whoever gave them the code, which on a custom profile is themselves.
    -->
    <string name="gate_no_model_custom">这个服务上找不到激活码里写的模型，检查一下模型名字。</string>

    <!--
      A profile that did not survive the trip, said four ways because only the first is the
      person's own to fix - and it is by far the likeliest, because codes travel through chat
      apps and chat apps cut long strings. "再粘贴一次" is advice that works for that one and
      for no other, so the four must not be collapsed into one sentence.
    -->
    <string name="gate_code_incomplete">激活码不完整，再粘贴一次试试。</string>
    <string name="gate_code_unreadable">这串激活码认不出来。</string>
    <string name="gate_code_missing">激活码里少了一项内容。</string>
    <string name="gate_code_insecure">激活码里的地址不安全，必须是 https 开头的。</string>

    <!--
      Shown once, before a pasted profile is stored: a profile names a server that will receive
      this person's questions and their token, and §1 means codes arrive from other people. It
      doubles as the check that the code pasted whole, which is why the model names are on it.
    -->
    <string name="gate_profile_title">这个激活码会把鱼丸连到：</string>
    <string name="gate_profile_llm">模型服务</string>
    <string name="gate_profile_search">搜索服务</string>
    <string name="gate_profile_models">模型</string>
    <string name="gate_profile_go">确认连接</string>
    <string name="gate_profile_back">取消</string>

    <!-- Confidence meter labels (spec §6, approved 2026-08-31). -->
    <string name="confidence_label">置信度</string>
    <string name="conflict_label">各有说辞</string>

    <!--
      Spec §25. "原话" and not "引用": the promise is that these are the source's own words,
      and the plainer word is the one that makes that promise legible to someone who has never
      thought about where an answer came from.
    -->
    <!-- The gate's failure detail, one tap under the message. For whoever gets asked for help. -->
    <!-- Spec §21 — the wait, named. -->
    <string name="thinking">思考中…</string>

    <!-- The working-out, kept after the answer arrives rather than discarded with the wait. -->
    <string name="process_show">看过程</string>
    <string name="open_source">打开原网页</string>

    <string name="detail_show">详情</string>
    <string name="detail_hide">收起</string>

    <string name="quote_show">看原话</string>
    <string name="quote_hide">收起</string>

    <!--
      The three marks under an answer. All four strings are read out rather than shown: the row
      is marks, not words, because a line of text under an answer reads as something the app
      said. See AssistantBubble.
    -->
    <string name="answer_work_show">看它是怎么想的</string>
    <string name="answer_work_hide">收起过程</string>
    <string name="answer_copy">复制答案</string>
    <string name="answer_copied">已复制</string>
    <string name="answer_quote">引用这段，接着问</string>

    <!-- A picture the answer carries, while it loads and if it never does. -->
    <string name="answer_image_loading">图片加载中…</string>
    <string name="answer_image_failed">这张图打不开了</string>

    <!--
      What a quoted answer looks like in the composer. The marks are the Chinese ones, because
      this is read by the person typing under it, not by a Markdown renderer.
    -->
    <string name="quote_prefix">「%1$s」\n\n</string>

    <!--
      Memory screen. NOT YET APPROVED - these are the designer's proposals from
      docs/06-design-directions.md Appendix 2, used so the screen exists and can be judged.
      The two tab names in particular are the author's call.
    -->
    <string name="back">返回</string>
    <string name="memory_tab_world">网上学到的</string>
    <string name="memory_tab_personal">关于你的</string>
    <string name="memory_empty_world">还没有从网上记下什么。</string>
    <string name="memory_empty_personal">还没有记下关于你的事。</string>
    <!--
      The row's bin, at rest and armed. 删除 rather than 忘掉 in the prompt: 忘掉 is what the
      app does to a memory over time on its own, and the tap being confirmed here is the user
      taking it out, which is a different and more final thing to be told about.
    -->
    <string name="memory_forget">忘掉</string>
    <string name="memory_forget_confirm">再次点击删除</string>

    <!--
      The update notice. It interrupts, so it says the whole thing in four short lines: what
      this is, which version, what the button does, and how to make it go away.

      No version numbers in the body copy beyond the label - "0.2a" means nothing to the
      person reading this, and the only question they actually have is whether to press it.
    -->
    <string name="update_title">鱼丸有新版本了</string>
    <string name="update_version">版本 %1$s</string>
    <string name="update_install">马上更新</string>
    <string name="update_later">以后再说</string>
    <string name="update_downloading">正在下载，先别关掉…</string>
    <!--
      Android will not let one app install another without a per-app permission, and the only
      place to grant it is Settings. Says what to do there, not that something went wrong.
    -->
    <string name="update_permission">系统要你先允许鱼丸安装应用。点下面这个按钮，把开关打开，再回来就能装了。</string>
    <string name="update_open_settings">去打开</string>

    <!--
      The version row on the settings screen. The number is shown because it is the first thing
      anyone helping over the phone asks for; the check answers either way, because pressing it
      is a question, unlike the launch check.
    -->
    <string name="settings_version">版本</string>
    <string name="version_current">鱼丸 %1$s</string>
    <string name="update_check">检查更新</string>
    <string name="update_latest">已经是最新版了。</string>
    <string name="update_unreachable">这会儿连不上网站，等下再试。</string>

    <!--
      No privacy_disclosure string. Spec §22 was reversed: the operator says it in person,
      the app says nothing. Deliberate absence, not an oversight - do not re-add it.
    -->
</resources>
