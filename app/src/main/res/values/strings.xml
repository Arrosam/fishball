<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-facing text. The codebase is English; the product speaks Chinese, because it
  answers a Chinese-speaking user (spec §12). Keeping the copy here rather than inline means
  the Kotlin stays readable and the wording stays reviewable in one place.
-->
<resources>
    <string name="app_name">FishBall</string>

    <!-- Masthead -->
    <string name="wordmark">FISHBALL</string>
    <string name="memory">记忆</string>

    <!-- Composer: no placeholder by design. The field and the send control carry it. -->
    <string name="send">发送</string>

    <!-- The thread before anything is in it. Author's copy, approved 2026-08-31. -->
    <string name="thread_empty">我是鱼丸，你的私人AI助理，来问我第一个问题，让我们一起探索这个世界吧！</string>

    <!-- Activation: spec §1, one key handed over in person. No instructional paragraph -
         the placeholder names what is being asked for and that is the whole instruction. -->
    <string name="gate_key_hint">请输入激活码</string>
    <string name="gate_confirm">确认</string>

    <!-- Confidence meter labels (spec §6, approved 2026-08-31). -->
    <string name="confidence_label">置信度</string>
    <string name="conflict_label">各有说辞</string>

    <!--
      Memory screen. NOT YET APPROVED - these are the designer's proposals from
      docs/06-design-directions.md Appendix 2, used so the screen exists and can be judged.
      The two tab names in particular are the author's call.
    -->
    <string name="back">返回</string>
    <string name="memory_tab_world">网上学到的</string>
    <string name="memory_tab_personal">关于你的</string>
    <string name="memory_empty_world">还没有从网上记下什么。</string>
    <string name="memory_empty_personal">还没有记下关于你的事。</string>
    <string name="memory_forget">忘掉</string>

    <!--
      No privacy_disclosure string. Spec §22 was reversed: the operator says it in person,
      the app says nothing. Deliberate absence, not an oversight - do not re-add it.
    -->
</resources>
