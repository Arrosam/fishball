<?xml version="1.0" encoding="utf-8"?>
<!--
  Camera. Body, a raised finder block on the left shoulder, and a square lens -
  the lens is a square because a circle is the one shape this design does not
  contain anywhere.

  Geometry from docs/06-design-directions.md section E: 24 grid, stroke 1.5,
  butt caps, miter joins. Colour is set by the Icon() tint at the call site.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M3 8 H7 V6 H12 V8 H21 V19 H3 Z"
        android:strokeColor="#FF101010"
        android:strokeWidth="1.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
    <path
        android:pathData="M9 11 H15 V17 H9 Z"
        android:strokeColor="#FF101010"
        android:strokeWidth="1.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
