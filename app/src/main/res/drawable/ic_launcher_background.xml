<?xml version="1.0" encoding="utf-8"?>
<!--
  Ink, with one glass disc on it.

  The ground is the masthead's, for the reason the masthead has never looked sinister. The disc
  is areel.org's `.shell` at icon scale, and it is the whole recipe rather than a tint: the
  148deg wash, the 112deg specular streak, the white edge and the lit top lip. The streak is the
  part that makes it read as glass - without it the disc was a lighter circle, which is what a
  wash on its own always is.

  A circle, in a design with none. Allowed here because it is a lens rather than a shape, and
  because a launcher mask is going to round it anyway.

  Radius 30 against a fish whose corners reach 26.8 from centre, so the mark sits on the pane
  with a little margin instead of bursting out of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#101010"
        android:pathData="M0,0h108v108h-108z" />

    <!-- background: linear-gradient(148deg, .26, .06, .18) -->
    <path android:pathData="M54,24 a30,30 0 1,0 0.1,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="21"
                android:endX="72"
                android:endY="87">
                <item android:offset="0" android:color="#42FFFFFF" />
                <item android:offset="0.46" android:color="#0FFFFFFF" />
                <item android:offset="1" android:color="#2EFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ::before - the specular streak, 112deg, clipped to the pane -->
    <group>
        <clip-path android:pathData="M54,24 a30,30 0 1,0 0.1,0 Z" />
        <path android:pathData="M0,0h108v108h-108z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="-11"
                    android:startY="28"
                    android:endX="119"
                    android:endY="80">
                    <item android:offset="0.38" android:color="#00FFFFFF" />
                    <item android:offset="0.46" android:color="#66FFFFFF" />
                    <item android:offset="0.54" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- border: 1px solid rgba(255,255,255,.6) -->
    <path
        android:pathData="M54,24 a30,30 0 1,0 0.1,0 Z"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="1" />

    <!-- rgba(255,255,255,.7) 0 1px 0 inset - the lit lip, over the top of the pane -->
    <path
        android:pathData="M25,46.2 A30,30 0 0,1 83,46.2"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="1.4" />
</vector>
