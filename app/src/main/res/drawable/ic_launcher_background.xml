<?xml version="1.0" encoding="utf-8"?>
<!--
  Ink, with one glass disc on it.

  The ground is the masthead's, for the reason the masthead has never looked sinister.

  The disc is the shell's wash and its edge, and deliberately not the rest of it. A full-strength
  112deg streak was tried and read as a bright diagonal slash across a 48dp circle: correct at
  bubble size, where the pane is 300dp wide and the streak is a glint travelling across it, and
  far too loud when the same proportion lands on something the size of a fingernail. What is
  left is the part that survives being small.

  A circle, in a design with none. Allowed here because it is a lens rather than a shape, and
  because a launcher mask is going to round it anyway.

  Radius 30 against a fish whose corners reach 26.8 from centre, so the mark sits on the pane
  with a little margin instead of bursting out of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#101010"
        android:pathData="M0,0h108v108h-108z" />

    <path android:pathData="M54,24 a30,30 0 1,0 0.1,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="24"
                android:endX="75"
                android:endY="84">
                <item android:offset="0" android:color="#3DFFFFFF" />
                <item android:offset="0.46" android:color="#14FFFFFF" />
                <item android:offset="1" android:color="#2BFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The shell's white edge, which is what makes a wash read as a pane at all. -->
    <path
        android:pathData="M54,24 a30,30 0 1,0 0.1,0 Z"
        android:strokeColor="#8CFFFFFF"
        android:strokeWidth="1" />
</vector>
