<?xml version="1.0" encoding="utf-8"?>
<!--
  Check. Two 45 runs, which is the whole mark - it stands in for ic_copy for a
  moment after a copy lands, so it has to read at 18dp with nothing else on it.

  Geometry from docs/06-design-directions.md section E: 24 grid, stroke 1.5,
  butt caps, miter joins. Colour is set by the Icon() tint at the call site.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M5 13 L10 18 L20 8"
        android:strokeColor="#FF101010"
        android:strokeWidth="1.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
