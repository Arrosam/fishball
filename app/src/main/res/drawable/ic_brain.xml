<?xml version="1.0" encoding="utf-8"?>
<!--
  Memory. A meander spiral - the folds of a brain abstracted to the Greek-key
  language the checkerboard already lives in. Tinted magenta at the call site;
  an 18dp icon is a non-text component judged at 3:1, which magenta clears.

  Geometry from docs/06-design-directions.md section E: 24 grid, stroke 1.5,
  butt caps, miter joins, runs orthogonal or 45 degrees, coordinates on integers.
  The pathData is byte-identical to the SVG "d" on the design board, so the two
  surfaces cannot drift. Colour is set by the Icon() tint at the call site, not here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M4 4 H20 V20 H8 V8 H16 V16 H12"
        android:strokeColor="#FF101010"
        android:strokeWidth="1.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
