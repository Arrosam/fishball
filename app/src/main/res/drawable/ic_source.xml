<?xml version="1.0" encoding="utf-8"?>
<!--
  Source mark. Two opposing corner brackets - a drawn Chinese quotation pair.
  Replaces the emoji paperclip. It doubles as the affordance for spec section 25:
  tapping a source shows the verified quotation, so the mark IS a quote mark.

  Geometry from docs/06-design-directions.md section E: 24 grid, stroke 1.5,
  butt caps, miter joins, runs orthogonal or 45 degrees, coordinates on integers.
  The pathData is byte-identical to the SVG "d" on the design board, so the two
  surfaces cannot drift. Colour is set by the Icon() tint at the call site, not here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M10 5 H5 V10 M14 19 H19 V14"
        android:strokeColor="#FF101010"
        android:strokeWidth="1.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />
</vector>
