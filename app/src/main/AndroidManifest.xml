<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Handing a downloaded APK to the system installer. This only permits *asking*: the user
      still grants FishBall the "install unknown apps" right in Settings, and still confirms
      the install itself. Without it the installer opens on the file and fails, which reads as
      a broken app rather than a missing permission.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Holding the composer's button down to speak instead of type. Asked for at the moment the
      button is first held, not on launch: a microphone prompt on the activation screen, before
      anything has been said, is a request with no visible reason for it.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Telling somebody the answer is ready once they have stopped watching for it. A turn is
      allowed to run a long time now, which is exactly when the phone gets put down. Asked for
      from Settings, next to the switch that turns it on, rather than on launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Staying alive while a question is being answered. A turn is minutes of network on something
      the person asked and then put the phone down over, and a backgrounded process with nothing
      to show for itself is the first thing Android reclaims - on the shells this app is actually
      used on, within seconds. The service does no work; it exists so the process is one the
      system leaves alone. See data/Awake.kt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FishBall">

        <!--
          Lets the system installer read the one APK we downloaded, and nothing else in the
          cache. See res/xml/update_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!--
          Runs only while a turn does, started and stopped by the screen that owns the turn.
          `dataSync` because that is what it is: a network transfer on the user's behalf, which
          from API 34 has to be declared before the service may put itself in the foreground.
        -->
        <service
            android:name=".data.TurnService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Portrait only. The layout is built around a single column - a masthead, a thread,
          and a composer pinned to the bottom - and there is nothing sensible for it to do
          with a landscape window. Locking it also means a rotation never recreates the
          activity, so a half-typed question survives the phone being tilted.

          Note for a future targetSdk bump: from Android 16, apps targeting SDK 36+ have
          orientation restrictions ignored on large screens, so this stops being a guarantee
          there and the layout would need to actually handle width.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
